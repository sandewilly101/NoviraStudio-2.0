# --- Server ---
PORT=4150
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:4150

# --- MySQL (XAMPP / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=novira_studio

# --- AI: scene planning and chat edits (GPT-4o) ---
# Without a key, Novira falls back to a built-in rule-based planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- AI: images and photoreal previews (Nano Banana) ---
# Option A: nanobnana.com API key. Its edit endpoint needs a public image link,
# so frames are hosted on Cloudinary first (fill in the CLOUDINARY_* keys).
NANOBANANA_API_KEY=
# Preview renders: model nano | nano2 | nano2pro (best), resolution 1K | 2K | 4K
NANOBANANA_MODEL=nano2pro
NANOBANANA_RESOLUTION=4K
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Option B: Google Gemini image model directly.
# Without either, "Photoreal preview" saves the plain 3D screenshot.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- 3D models: Sketchfab ---
# Search works without a token; importing (downloading) a model needs one.
SKETCHFAB_API_TOKEN=

# --- Seed: venue file copied in by `npm run seed` ---
SEED_VENUE_PATH=C:/Users/pc/Downloads/sande/Nozila/rotana for apoli.glb
